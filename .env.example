# MarioBot / OpenRouter — supplied by client, never commit real values
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MARIOBOT_SLUG=

# Genesis — pending clarification, see docs/QUESTIONS.md
GENESIS_API_KEY=
GENESIS_BASE_URL=

# Visual hook extraction from opening frames
ANTHROPIC_API_KEY=

# Prisma resolves relative paths against prisma/schema.prisma, so ../ puts the
# database at the repo root where the CLI and the Python enrichment worker expect it.
DATABASE_URL="file:../data.db"

# Boot from fixtures/sample-feed.json instead of a live session
SEED_FROM_FIXTURE=1

# Optional. Baselines (each author's recent public posts) are fetched off-session
# through Apify instead of by visiting profiles from the burner account, which is
# the biggest source of automated requests in a harvest. Falls back to the browser
# visit when unset. Roughly $0.32 per 10-author harvest on the free tier.
APIFY_TOKEN=
